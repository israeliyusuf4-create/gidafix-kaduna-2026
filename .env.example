# Copy this file to .env, then start using the environment variables below.
# Node will not read .env automatically: use `node --env-file=.env server.mjs`.
PORT=3000
NODE_ENV=development
DEMO_MODE=true
GIDAFIX_ADMIN_TOKEN=replace-with-a-long-random-secret
WEBHOOK_SECRET=replace-with-a-different-long-random-secret
AT_MODE=mock
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
DATA_FILE=./data/gidafix.json
